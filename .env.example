# VibeFinder 2.0 — environment variables
# Copy this file to .env and fill in your keys.

# REQUIRED: Google AI Studio key for Gemini 2.0 Flash (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: Spotify app credentials. If omitted, the backend falls back to Deezer.
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# OPTIONAL: override the Gemini model id (defaults to gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
