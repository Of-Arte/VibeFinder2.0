# VibeFinder 2.0 -- environment variables
# Copy this file to .env and fill in your key.

# REQUIRED: Google AI Studio key for Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OPTIONAL: override the Gemini model id (defaults to gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-lite-latest

# OPTIONAL: per-client rate limit for POST /api/recommend.
# Each client (by IP) may generate this many playlists per rolling window.
# RATE_LIMIT_MAX_REQUESTS=3
# RATE_LIMIT_WINDOW_SECONDS=3600

# NOTE: Track retrieval uses the public, keyless Deezer API -- no keys required.
